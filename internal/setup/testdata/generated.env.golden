# ==============================================================================
# VIDRA — PRODUCTION ENVIRONMENT TEMPLATE (test fixture)
# ==============================================================================
# A TRIMMED copy of the meta repo's env/production.env.example, kept here only to
# pin this package's handling of the real file's FORMAT: comment blocks, section
# rules, blank secrets with their generate: command, deliberately malformed
# <generate: ...> placeholders, commented-out optional keys, and a value with a
# space in it. It is not a deployment template — the authoritative one lives in
# the meta repo and is passed to the engine as an argument.
#
# BEFORE FIRST BOOT, replace every <generate: ...> placeholder below.
# ==============================================================================

VIDRA_ENV=production

# ------------------------------------------------------------------------------
# Release tags — which images to pull
# ------------------------------------------------------------------------------
VIDRA_CORE_TAG=v0.1.1
VIDRA_USER_TAG=v0.1.1
VIDRA_SEARCH_TAG=v0.1.1

# ------------------------------------------------------------------------------
# Origin topology — ONE domain, routed by path
# ------------------------------------------------------------------------------
# Must be https in production and must NOT include a path or trailing slash.
PUBLIC_BASE_URL=https://video.example.org
NEXT_PUBLIC_API_BASE_URL=https://video.example.org
CORS_ALLOWED_ORIGINS=https://video.example.org

HTTP_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Secrets — replace every placeholder; never commit the filled-in file
# ------------------------------------------------------------------------------
# JWT signing key for access tokens (HS256).
#   generate: openssl rand -base64 48
# Left EMPTY rather than pre-filled: an empty value falls back to the built-in
# dev constant, which the api REFUSES in production.
JWT_SECRET=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4v

# Base64 of exactly 32 bytes. Envelope-encrypts TOTP shared secrets at rest.
#   generate: openssl rand -base64 32
# DESTRUCTIVE TO ROTATE: it seals rows already in the database.
MFA_KEY_KEK=MDEyMzQ1Njc4OTo7PD0+P0BBQkNERUZHSElKS0xNTk8=

# Bundled PostgreSQL. Use HEX, not base64: this password is substituted into a
# postgres:// DSN.
#   generate: openssl rand -hex 32
POSTGRES_USER=vidra
POSTGRES_PASSWORD=505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f
POSTGRES_DB=vidra

# Bundled Redis. Same hex rationale as above.
#   generate: openssl rand -hex 32
REDIS_PASSWORD=707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f

# ------------------------------------------------------------------------------
# Database DSN overrides (managed-service path)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://doadmin:PASSWORD@db.example.net:25060/defaultdb?sslmode=require

# ------------------------------------------------------------------------------
# Instance identity
# ------------------------------------------------------------------------------
INSTANCE_NAME=Example Video
INSTANCE_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# Registration
# ------------------------------------------------------------------------------
REGISTRATION_ENABLED=false
REGISTRATION_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# Media storage — S3-compatible object storage
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
# HOST ONLY — no scheme.
STORAGE_S3_ENDPOINT=nyc3.digitaloceanspaces.com
STORAGE_S3_REGION=nyc3
STORAGE_S3_BUCKET=example-video-media
# SECRETS — never commit or log them.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_SSL=true

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# SMTP_HOST and SMTP_FROM are REQUIRED when MAIL_ENABLED=true.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET — never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# Dev/test seams — MUST stay false in production
# ------------------------------------------------------------------------------
DEV_MAIL_CAPTURE_ENABLED=false

# ------------------------------------------------------------------------------
# vidra-search (internal service — never browser-facing)
# ------------------------------------------------------------------------------
SEARCH_SERVICE_URL=http://search:8080
# Must equal the search service's INTERNAL_SECRET; the single substitution below
# feeds both sides.
#   generate: openssl rand -hex 32
SEARCH_INTERNAL_SECRET=909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf

# ------------------------------------------------------------------------------
# ActivityPub federation (off)
# ------------------------------------------------------------------------------
#   generate: openssl rand -base64 32
FEDERATION_ENABLED=false
# FEDERATION_KEY_KEK=
