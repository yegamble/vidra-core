# Ralph generated/runtime files (in any .ralph/)
**/.ralph/.call_count
**/.ralph/.last_reset
**/.ralph/.last_output_length
**/.ralph/.loop_start_sha
**/.ralph/.token_count
**/.ralph/.exit_signals
**/.ralph/status.json
**/.ralph/progress.json
**/.ralph/live.log
**/.ralph/.ralph_session
**/.ralph/.ralph_session_history
**/.ralph/.claude_session_id
**/.ralph/.response_analysis
**/.ralph/.circuit_breaker_state
**/.ralph/.circuit_breaker_history

# Ralph logs and generated docs
**/.ralph/logs/*
!**/.ralph/logs/.gitkeep
**/.ralph/docs/generated/*
!**/.ralph/docs/generated/.gitkeep

# Ralph backup directories
.ralph_backup_*

# General logs
*.log

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.temp/

# --- Go ---
bin/
dist/
*.test
*.out

# --- Env ---
.env
.env.local
.env.*.local

# --- Secrets: private IPFS swarm (fix_plan P19.P3) ---
# swarm.key == full private-network membership; a cluster secret authenticates cluster
# membership. Both are operator-managed in production and must NEVER be committed. The
# compose profile auto-generates a DEV key into a named volume (not the repo tree); this
# only guards an operator who drops a real key/secret under deploy/ipfs-private/.
swarm.key
*.swarm.key
deploy/ipfs-private/swarm.key
deploy/ipfs-private/*.key
deploy/ipfs-private/cluster-secret
deploy/ipfs-private/*.peerid

# IDE files
.vscode/
.idea/
*.swp
*.swo
