# Vidra core — example environment. Copy to .env and adjust for local dev.
# NEVER commit a real .env or any real secrets.

# Runtime environment: development | test | production
VIDRA_ENV=development

# Logging (see .ralph/specs/observability.md).
# Minimum emitted level: debug | info | warn | error (default info).
LOG_LEVEL=info
# Output format: json (default, production) | text (readable local dev).
LOG_FORMAT=json
# OpenTelemetry tracing (opt-in; zero cost when off). When OTEL_ENABLED=true,
# spans export to OTEL_EXPORTER_OTLP_ENDPOINT (host:port, no scheme) over
# OTEL_EXPORTER_OTLP_PROTOCOL (grpc | http/protobuf); the endpoint is required
# when enabled. vidra-core accepts inbound W3C traceparent so frontend↔backend
# traces correlate, and logs carry trace_id/span_id when a span is active.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=vidra-core
# When OTEL_ENABLED, spans also cover PostgreSQL queries, Redis commands, and
# outbound HTTP (federation/import/whisper) with W3C traceparent injected. Run a
# local tracing backend with: docker compose --profile core --profile otel up
# (collector on otel-collector:4317; Jaeger UI at http://localhost:16686).

# Prometheus RED metrics (opt-in; zero cost when off). When true, GET /metrics
# serves request rate/error/duration histograms (labelled by method + route
# template + status class) and a durable-queue depth gauge. The endpoint is
# unauthenticated and lives at the root — network-scope it to your Prometheus
# scrape, do not expose it publicly.
METRICS_ENABLED=false

# Human-facing instance name (shown in NodeInfo / discovery).
INSTANCE_NAME=Vidra (dev)
# Malware scanning of uploaded originals before publish. Off by default; when on,
# CLAMAV_ADDR must point at a clamd daemon (host:port) — the compose "scan" profile
# ships one (CLAMAV_ADDR=clamav:3310).
MALWARE_SCAN_ENABLED=false
CLAMAV_ADDR=
# CLAMAV_TIMEOUT bounds a single INSTREAM scan (dial + stream + verdict). A slow
# or wedged clamd surfaces as a scan ERROR within this window — resolved by
# MALWARE_SCAN_MODE below — instead of hanging the upload. time.ParseDuration
# syntax (e.g. 60s, 2m); default 60s; must be > 0 when MALWARE_SCAN_ENABLED=true.
CLAMAV_TIMEOUT=60s
# MALWARE_SCAN_MODE: the fallback policy applied when a scan cannot COMPLETE (a
# dial/protocol/IO error) — an INFECTED result always fails the publish, in every
# mode. One of:
#   fail-closed (default) — unscannable media is not published (state 'failed').
#   fail-open             — publish anyway, logged loudly (dev / degraded scanner).
#   quarantine            — park in the 'quarantined' state for moderator review.
MALWARE_SCAN_MODE=fail-closed
# HLS transcoding: when true, publishing a video enqueues a durable transcode job
# and an in-process worker produces an H.264/AAC HLS ladder (rungs 1080/720/480/360,
# capped at the source height) served at /api/v1/videos/{id}/hls/*. This ladder is
# what powers the player's resolution/quality selector — with it off a video only
# serves its single progressive original, so playback is stuck at one resolution.
# Requires ffmpeg and ffprobe on PATH (the Docker image ships them; a host without
# them degrades gracefully — boot logs a warning and leaves transcoding off).
# On by default (matches docker-compose and the meta env templates); set
# TRANSCODING_ENABLED=false to serve originals only.
TRANSCODING_ENABLED=true
# TRANSCODING_VP9_ENABLED additionally emits a progressive VP9/WebM alternate per
# video alongside the H.264 ladder (surfaced via GET /videos/{id}/download and
# served at /videos/{id}/webm). Off by default. Only meaningful with transcoding on.
TRANSCODING_VP9_ENABLED=false
# TRANSCODING_STREAM_OUTPUT writes the HLS ladder straight into object storage
# through a loopback signing sidecar, so segments never land on the transcode
# scratch volume. This is a TRADE, not a free win: the pipeline reads its own
# output back to build the progressive downloads, so those reads become
# object-store range requests. Turn it on where scratch is scarce and egress is
# cheap or CDN-fronted (e.g. Backblaze B2 via the Bandwidth Alliance); leave it
# off where egress is metered and disk is plentiful. Needs STORAGE_BACKEND=s3
# to be worth anything. Off by default.
TRANSCODING_STREAM_OUTPUT=false
# TRANSCODING_MIN_FREE_SCRATCH_MB is the free-space floor on the transcode scratch
# filesystem (TMPDIR) below which the worker claims no new jobs. A transcode writes
# several times its source before anything is uploaded, and on a single-disk host
# that volume shares a filesystem with the Postgres data directory — so filling it
# does not merely fail a job, it stops the database accepting writes. Jobs deferred
# for space stay pending and do NOT consume their retry budget. 0 = built-in
# default (10 GiB).
TRANSCODING_MIN_FREE_SCRATCH_MB=0
# TRANSCODING_AV1_ENABLED is DEFERRED: setting it true fails config validation with
# a defer note (mirrors the IPFS-storage defer). Leave false.
TRANSCODING_AV1_ENABLED=false
# Publish-after-transcode safety valve: how long a video may sit waiting on its
# transcode before the stuck-hold sweeper publishes it from the ORIGINAL anyway
# (a CAS transition, so a transcode that later finishes still promotes cleanly).
# This is what stops a crashed or OOM-killed worker from hiding a video forever;
# lowering it shortens that window at the cost of publishing un-laddered sooner.
TRANSCODE_HOLD_TIMEOUT=12h
# Auto-caption (Whisper). When WHISPER_ENABLED=true a video owner can request an
# auto-generated WebVTT caption track (POST /videos/{id}/captions/auto): an
# in-process worker extracts the audio (ffmpeg → 16 kHz mono WAV) and POSTs it to
# WHISPER_ENDPOINT, a whisper.cpp /inference-compatible transcription service.
# WHISPER_ENDPOINT is REQUIRED when enabled; it is trusted operator config (an
# internal service), so it is not SSRF-guarded. Run the bundled server with the
# compose "captions" profile (WHISPER_ENDPOINT=http://whisper:8080). Off by default;
# when off, the auto-caption endpoint answers 503 and no worker runs.
WHISPER_ENABLED=false
WHISPER_ENDPOINT=
# Caption language used when a request omits one (also the transcription hint).
WHISPER_DEFAULT_LANGUAGE=en
# yt-dlp platform-URL import (backport W2.C1, UPLOAD-09). OFF by default — an
# admin/config opt-in. When on, a URL import may resolve through the HARD-SANDBOXED
# yt-dlp extractor (fixed argv, --ignore-config, no shell, no --exec, no runtime
# self-update, private tmp workdir, hard timeout, --max-filesize). Bytes still land
# ONLY via AttachOriginal → Process, so the ClamAV scan hook fires before anything
# is servable.
#
# SECURITY — RESIDUAL RISK + EGRESS PROXY (spec §5): yt-dlp makes its OWN outbound
# HTTP fetches, which the api's dial-time SSRF guard cannot pin, so a hostile page
# could try to redirect it at internal addresses. Mitigations, in order: (1) it is
# OFF by default; (2) set YTDLP_PROXY to a forward proxy that DENIES RFC1918 /
# loopback / link-local (see the `ytdlp-egress` Squid sketch in docker-compose.yml);
# (3) run the api/worker on a network with no route to internal services. The yt-dlp
# binary must be PINNED in the image — never self-updated at runtime.
YTDLP_IMPORT_ENABLED=false
# Path to (or name on PATH of) the pinned yt-dlp binary. Required when enabled.
YTDLP_PATH=yt-dlp
# Hard wall-clock bound on one extractor invocation. Must be positive when enabled.
YTDLP_TIMEOUT=15m
# Caps the selected resolution (yt-dlp -f height<=N). 0 = no cap; otherwise
# 144..4320. Validated even when import is disabled — a nonsensical value is
# always a config error.
YTDLP_MAX_HEIGHT=1080
# RECOMMENDED IN PRODUCTION: route the extractor through an egress proxy that
# blocks internal ranges, e.g. http://ytdlp-egress:3128. http(s) or socks5(h) URL.
# Empty by default — documented and recommended, not enforced.
YTDLP_PROXY=
# Channel auto-sync (backport W2.C4, UPLOAD-13). Mirrors an external platform
# channel's recent uploads into a LOCAL channel by listing it with the sandboxed
# yt-dlp extractor (--flat-playlist) and enqueuing `ytdlp` imports for unseen
# entries — so bytes still land via AttachOriginal → Process. OFF by default and
# effective ONLY when YTDLP_IMPORT_ENABLED is also true (the sync IS a yt-dlp
# import path), so the egress-proxy stance above applies here too. When either is
# off the endpoints answer 503 and no worker runs. Synced uploads are created as
# PRIVATE drafts for the owner to review — never auto-published.
CHANNEL_SYNC_ENABLED=false
# Cadence at which a sync re-lists its external channel.
CHANNEL_SYNC_INTERVAL=1h
# Max sync configurations one user may own, and max unseen entries imported per
# sync pass (the batch bounds how much a newly-added large channel enqueues at once).
CHANNEL_SYNC_MAX_PER_USER=5
CHANNEL_SYNC_BATCH=15
# Minimum spacing between MANUAL POST /channels/{handle}/sync-now triggers for one
# sync, so the button cannot be used to hammer the external platform. <=0 disables
# the throttle; negative values are rejected when channel sync is enabled.
CHANNEL_SYNC_COOLDOWN=1m
# vidra-search integration (search-service W4, MASTER-PLAN §2.6). SEARCH_SERVICE_URL
# is the vidra-search origin (e.g. http://search:8080); EMPTY disables the whole
# integration — suggestions degrade to empty, search/recommendations fall back to
# local SQL, and no search client or outbox/reconcile worker runs. When set in
# production, SEARCH_INTERNAL_SECRET is REQUIRED (>=32 chars) and MUST match the
# search service's INTERNAL_SECRET (HMAC S2S auth). NEVER commit a real secret.
SEARCH_SERVICE_URL=
SEARCH_INTERNAL_SECRET=
# Optional per-endpoint client deadline overrides in ms (0 = defaults 250/800/800).
SEARCH_SUGGEST_TIMEOUT_MS=0
SEARCH_QUERY_TIMEOUT_MS=0
SEARCH_RECS_TIMEOUT_MS=0
# Cadence of the full index reconcile sweep (index-repair backstop). Default 24h.
SEARCH_RECONCILE_INTERVAL=24h
# Base cadence of the background health prober (GET /healthz; jittered ±20%). The
# prober is the active half of the smart-search routing policy (W9): a down service
# is detected within ~2 intervals so gateway surfaces fail over to backup with no
# per-request timeout latency. Default 15s. Only runs when SEARCH_SERVICE_URL is set.
SEARCH_HEALTH_INTERVAL=15s
# ActivityPub federation (see .ralph/specs/federation.md). Off by default: when
# FEDERATION_ENABLED=false all federation routes (NodeInfo, and later actors/
# WebFinger/inbox) are unmounted. When true, PUBLIC_BASE_URL must be set to this
# instance's canonical origin (no path/trailing slash; https in production) — it
# is used to build actor/object ids and the NodeInfo document URL.
FEDERATION_ENABLED=false
PUBLIC_BASE_URL=
# Base64 (standard) 32-byte key that envelope-encrypts federation actor private
# keys at rest (AES-256-GCM). REQUIRED in production when FEDERATION_ENABLED=true;
# empty in dev stores keys raw (with a boot warning). Generate with:
#   openssl rand -base64 32
# NEVER commit a real value.
FEDERATION_KEY_KEK=
# ATProto / Bluesky extension (see .ralph/specs/atproto.md) — v1 outbound
# cross-posting ONLY, INDEPENDENT of ActivityPub (enable either, both, or
# neither). Off by default: when ATPROTO_ENABLED=false the /me/atproto link
# endpoints answer 503 and no auto-post worker runs. When true, a creator can
# link a Bluesky account (handle + app password) and opt into auto-announcing
# their published PUBLIC videos on Bluesky.
ATPROTO_ENABLED=false
# ATProto IDENTITY LOGIN — let anyone sign in with their ATProto handle (Bluesky
# `alice.bsky.social` or any self-hosted PDS) via ATProto OAuth (PAR + PKCE +
# DPoP). INDEPENDENT of ATPROTO_ENABLED above (cross-posting): enable either,
# both, or neither. Off by default: when false the /api/v1/auth/atproto/start +
# /callback endpoints answer 503. Vidra acts as a public client with scope
# `atproto` only and discards the PDS tokens after verifying the DID, so NO key
# is required. Requires PUBLIC_BASE_URL to be set (client_id/redirect_uri derive
# from it; an https origin uses the hosted client-metadata document).
ATPROTO_LOGIN_ENABLED=false
# Base64 (standard) 32-byte key that envelope-encrypts linked Bluesky app
# passwords at rest (same secretbox envelope as FEDERATION_KEY_KEK, which it
# FALLS BACK to when unset). REQUIRED in production when ATPROTO_ENABLED=true;
# with neither set (dev), app passwords are stored raw and the api warns at boot.
# Generate with: openssl rand -base64 32. NEVER commit a real value.
ATPROTO_KEY_KEK=
# Base64 (standard) 32-byte key that envelope-encrypts TOTP 2FA shared secrets
# at rest (same secretbox envelope as FEDERATION_KEY_KEK, which it FALLS BACK
# to when unset — one KEK can cover both). With neither set (dev), TOTP secrets
# are stored raw and the api warns loudly at boot. Generate with:
#   openssl rand -base64 32
# NEVER commit a real value.
MFA_KEY_KEK=
# Issuer label authenticator apps show next to TOTP accounts enrolled on this
# instance (embedded in the otpauth:// enrollment URI). Defaults to INSTANCE_NAME.
TOTP_ISSUER=
# Whether public account signup is accepted (surfaced at GET /api/v1/instance).
REGISTRATION_ENABLED=true
# When true (and registration is enabled), signup files a pending request for
# admin approval instead of creating an account directly. Default false.
REGISTRATION_REQUIRE_APPROVAL=false
# When true, a finished upload by a non-privileged user (role "user" without the
# admin-granted bypass_quarantine flag) parks in the 'quarantined' state instead
# of publishing, until a moderator approves or rejects it (product-decisions §11).
QUARANTINE_NEW_UPLOADS=false
# Feature toggles (boot-time defaults; all default true). Each can be overridden
# live by an admin via PATCH /api/v1/admin/instance-settings — the DB overlay
# wins over these. When a toggle is off, the corresponding endpoint returns 403
# feature_disabled: new upload sessions + direct file upload (uploads), URL
# import (imports), live-stream create (live), and comment create (comments).
FEATURE_UPLOADS_ENABLED=true
FEATURE_IMPORTS_ENABLED=true
FEATURE_LIVE_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
# OAuth/OIDC login providers, disabled by default (empty list). Comma-separated
# provider names (lowercase letters/digits/dashes, e.g. "google,github-oidc");
# each named provider needs OAUTH_<NAME>_ISSUER (the OIDC issuer URL — discovery
# is fetched from <issuer>/.well-known/openid-configuration), _CLIENT_ID, and
# _CLIENT_SECRET (a SECRET: never commit or log it), plus optional _SCOPES
# (comma list; default "openid,email,profile"). Dashes in the name map to
# underscores in the env prefix. PUBLIC_BASE_URL is REQUIRED when any provider
# is configured — the OAuth callback redirect URI is derived from it
# server-side. Example:
#   OAUTH_PROVIDERS=google
#   OAUTH_GOOGLE_ISSUER=https://accounts.google.com
#   OAUTH_GOOGLE_CLIENT_ID=...
#   OAUTH_GOOGLE_CLIENT_SECRET=...
OAUTH_PROVIDERS=

# Real outbound email over SMTP. When true, password-reset and email-verification
# tokens are delivered to the account's address (plain-text mail; STARTTLS is used
# whenever the relay offers it; AUTH PLAIN when SMTP_USERNAME is set). SMTP_HOST
# and SMTP_FROM are required when enabled. SMTP_PASSWORD is a secret: NEVER commit
# a real value and never log it. DEV_MAIL_CAPTURE_ENABLED wins when both are on.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# DEV-ONLY test seam. When true, account-security tokens (password reset, email
# verification) are held in memory and retrievable via GET /api/v1/dev/email-token
# instead of being mailed, so end-to-end tests can complete the token flows. The
# route exists only when this is on and the process warns loudly on boot.
# NEVER enable in production — it exposes single-use credentials.
DEV_MAIL_CAPTURE_ENABLED=false
# DEV/TEST-ONLY: relax the URL-import SSRF guard so it may fetch private/loopback
# addresses (backed e2e imports from a loopback/compose-network origin, since a
# public origin isn't reachable in CI). NEVER enable in production — it re-opens
# the SSRF hole. The process warns loudly on boot when on.
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false
# Base RTMP ingest URL returned to a streamer on live-stream create (they append
# their stream key in OBS). Empty until an RTMP ingest is provisioned.
LIVE_RTMP_URL=
# Shared secret the media server (RTMP ingest) presents on the internal
# /api/v1/live/ingest/{start,stop} hooks (header X-Ingest-Secret) so only it can
# flip a stream's live state. Empty DISABLES the hooks (they 404). Set to a strong
# random value alongside your RTMP ingest.
LIVE_INGEST_SECRET=
# Directory the RTMP media server (the `media` compose profile) writes live HLS
# segments + session recordings into, shared with the api. When set, the api
# serves live HLS by stream ID at /api/v1/live/{id}/hls/* and republishes
# replay-enabled sessions as VODs. Use /live-hls with the media profile. Empty
# leaves live HLS serving + replay off.
LIVE_HLS_ROOT=
# Optional instance about/legal metadata (surfaced at GET /api/v1/instance).
INSTANCE_DESCRIPTION=
INSTANCE_TERMS_URL=
INSTANCE_PRIVACY_URL=
INSTANCE_CONTACT_EMAIL=

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Per-request context deadline (handlers/DB observe it; WriteTimeout is the hard cap).
HTTP_REQUEST_TIMEOUT=30s
# The longer deadline used INSTEAD of HTTP_REQUEST_TIMEOUT on the STREAMING routes:
# resumable chunk PUTs, direct upload/replace POSTs, DM attachment uploads, and the
# media GETs. Those requests are bounded by the client's link speed, not by server
# work — an 8 MiB chunk needs a sustained ~2.2 Mbit/s to finish inside 30s, so the
# general deadline makes a typical residential/mobile upload retry-loop forever and
# cuts long downloads mid-stream. A long deadline rather than none, so a stalled peer
# still eventually releases its goroutine and pooled DB connection. Must be positive.
HTTP_STREAM_REQUEST_TIMEOUT=1h
# Connection-level server timeouts. HTTP_SHUTDOWN_TIMEOUT bounds the graceful drain
# after SIGTERM (in Docker, a value above the container's stop grace period — 10s by
# default — only takes effect if that is raised too).
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s
# Max accepted request body size (Echo size string, e.g. 8M, 512K). Oversized -> 413.
HTTP_BODY_LIMIT=8M

# Rate limiting (Redis fixed-window, per client IP) on the /api surface.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
# Much larger budget (same window) for the media GETs — thumbnails, HLS playlists
# and segments, storyboards, downloads, avatars/banners. One home page is a single
# feed call plus ~20 thumbnails and HLS playback adds ~10 segments/minute, so a
# single ordinary viewer would blow RATE_LIMIT_REQUESTS in their first minute.
# These are cheap cacheable blob reads: they need a ceiling against scraping, not
# the API budget. 3000/1m is ~50 reads a second from one IP.
MEDIA_RATE_LIMIT_REQUESTS=3000
# Stricter per-IP budget (same window) for sensitive auth endpoints — login,
# register, the password-reset / email-verify confirmations, and the MFA
# challenge.
AUTH_RATE_LIMIT_REQUESTS=10
# Per-USER (not per-IP) budget for DM attachment uploads. DM attachments do not
# count against the storage quota (messaging-v2.md D6 / product-decisions §14), so
# this is the compensating anti-abuse control. Default 60 uploads / 10m. Gated by
# RATE_LIMIT_ENABLED; both must be > 0 when rate limiting is on.
ATTACHMENT_UPLOAD_RATE_LIMIT_REQUESTS=60
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW=10m

# Media storage. Backend: "local" (default; writes under STORAGE_LOCAL_ROOT) or
# "s3" (S3-compatible object storage). "ipfs" is deliberately rejected — IPFS is a
# mirror SIDECAR, not an authoritative backend (see the IPFS_* block below and
# .ralph/specs/ipfs-media.md).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/media
# S3-compatible settings (required when STORAGE_BACKEND=s3). The endpoint is
# host[:port] WITHOUT a scheme — STORAGE_S3_USE_SSL picks http/https.
# STORAGE_S3_FORCE_PATH_STYLE addresses the bucket as /<bucket>/<key> (required
# by MinIO; safe for most S3-compatibles). The api creates the bucket at boot if
# it is missing (when the credentials may). ACCESS/SECRET keys are credentials:
# NEVER commit real values and never log them.
# Provider examples:
#   MinIO (compose "storage" profile, from the api container):
#     STORAGE_S3_ENDPOINT=minio:9000  USE_SSL=false  FORCE_PATH_STYLE=true
#     (from the host use localhost:9000)
#   AWS S3:                STORAGE_S3_ENDPOINT=s3.us-east-1.amazonaws.com  STORAGE_S3_REGION=us-east-1
#   Backblaze B2:          STORAGE_S3_ENDPOINT=s3.us-west-004.backblazeb2.com (key id/application key as access/secret; FORCE_PATH_STYLE=true works)
#   DigitalOcean Spaces:   STORAGE_S3_ENDPOINT=nyc3.digitaloceanspaces.com  STORAGE_S3_REGION=nyc3 (bucket NOT in the endpoint)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=
STORAGE_S3_USE_SSL=true
STORAGE_S3_FORCE_PATH_STYLE=false
# Compose minio service (dev-only defaults; the storage profile's root creds).
MINIO_ROOT_USER=vidra
MINIO_ROOT_PASSWORD=vidra-dev-secret
MINIO_PORT=9000

# Hybrid IPFS media mirroring (fix_plan P19, .ralph/specs/ipfs-media.md). IPFS is
# an orthogonal MIRROR of eligible ALREADY-PUBLIC media, present IN ADDITION to
# the authoritative local/S3 store — never a replacement backend. All OFF by
# default; when off there is no worker, no enqueue, and the admin endpoints
# (GET /api/v1/ipfs/status, POST /api/v1/admin/ipfs/reconcile) answer 503.
# PRIVACY INVARIANT: nothing non-public is ever pinned to a public network
# (private/unlisted/quarantined videos, DM attachments, exports, upload chunks,
# the live edge, and remote thumbnails are all excluded).
IPFS_ENABLED=false
# Kubo RPC address and public gateway base — BOTH required when IPFS_ENABLED=true.
# The gateway URL is what clients see in API responses (never defaults to ipfs.io).
# For local dev, run the compose `ipfs` profile (docker compose --profile core
# --profile ipfs up) and use IPFS_API_URL=http://ipfs:5001 with the dev gateway
# IPFS_GATEWAY_URL=http://localhost:9090. The compose node is genuinely local-only
# by default. Set IPFS_PUBLIC_NETWORK=true to restore public bootstrap/DHT providing
# and enable relay/hole-punch reachability; in that mode set IPFS_GATEWAY_URL to the
# public/self-hosted gateway clients should use (for example https://ipfs.io).
# Public mode is a permanent-disclosure choice; see the spec §7/§12.
IPFS_API_URL=
IPFS_GATEWAY_URL=
# Compose-node switch (not consumed by the Go process). False blocks all swarm
# addresses, removes bootstrap peers, and disables routing/providing/relay. True makes the node a live public
# provider. `make ipfs-live` sets it explicitly.
IPFS_PUBLIC_NETWORK=false
# Per add/pin RPC timeout, worker parallelism (bounded — pinning is I/O heavy),
# and the reconciliation/backfill scan cadence.
IPFS_ADD_TIMEOUT=60s
IPFS_PIN_CONCURRENCY=2
IPFS_RECONCILE_INTERVAL=5m
# Optional IPFS Cluster REST API for PUBLIC-tier replication (STOR-05).
# IPFS_CLUSTER_TOKEN is a SECRET (Bearer token) — NEVER commit a real value / log it.
IPFS_CLUSTER_API_URL=
IPFS_CLUSTER_TOKEN=
#
# --- PRIVATE mirroring tier (fix_plan P19.P, .ralph/specs/ipfs-media-private.md) ---
# Master opt-in for replicating NON-public media (private/unlisted videos + their
# derivatives, non-public playlist covers, unlisted/deactivated-owner avatars &
# banners) to a SECOND, fully separate swarm.key'd kubo node. Default false.
# SUPERSESSION (P19.P1): setting this true is a HARD CONFIG ERROR unless
# IPFS_PRIVATE_API_URL is set — the shipped guard (needing a cluster URL) is REPLACED
# by requiring a DEDICATED private node. Private CIDs NEVER appear in any API
# response and there is deliberately NO private gateway URL knob (replication, not
# distribution). May run standalone with IPFS_ENABLED=false (private-only tier).
IPFS_MIRROR_PRIVATE=false
# RPC of the dedicated private-swarm kubo. REQUIRED when IPFS_MIRROR_PRIVATE=true;
# MUST differ from IPFS_API_URL (dual-homing is a hard config error — never run one
# node on both the public and private swarm). The private node is operator-managed:
# LIBP2P_FORCE_PNET=1 (fail-closed: won't boot without a swarm.key), swarm.key present,
# bootstrap cleared, Routing.Type=none, Provide.Enabled=false, Gateway.NoFetch, no
# public gateway. LOCAL DEV: run the compose `ipfs-private` profile
# (`docker compose --profile core --profile ipfs-private up`) and leave this blank —
# it defaults to http://kubo-private:5001 (RPC also on host :5002).
IPFS_PRIVATE_API_URL=
# ⚠️ swarm.key CUSTODY (fix_plan P19.P3): possession of the key == full private-network
# membership. There is NO per-node revocation; rotation = a NEW key + a coordinated
# restart of EVERY node (nodes on different keys cannot talk). The compose profile
# auto-generates a DEV key into a named volume; in PRODUCTION you generate it ONCE
# (`printf '/key/swarm/psk/1.0.0/\n/base16/\n%s\n' "$(od -vN 32 -An -tx1 /dev/urandom | tr -d ' \n')"`),
# distribute the SAME file to every node, mount it read-only, and NEVER commit it
# (.gitignore guards deploy/ipfs-private/*.key).
# Optional IPFS Cluster REST API + Bearer token on the PRIVATE swarm (P19.P3; a fully
# separate cluster from the public one). IPFS_PRIVATE_CLUSTER_TOKEN is a SECRET —
# NEVER commit a real value / log it. Local dev: run the `ipfs-private-cluster` profile
# and set IPFS_PRIVATE_CLUSTER_API_URL=http://ipfs-cluster-private:9094.
IPFS_PRIVATE_CLUSTER_API_URL=
IPFS_PRIVATE_CLUSTER_TOKEN=
# The cluster membership secret shared by every PRIVATE cluster peer (32-byte hex,
# `od -vN 32 -An -tx1 /dev/urandom | tr -d ' \n'`). Consumed by the compose
# `ipfs-cluster-private` service. A SECRET — NEVER commit a real value.
IPFS_PRIVATE_CLUSTER_SECRET=
# Private-worker tuning; INHERIT the public IPFS_ADD_TIMEOUT / IPFS_PIN_CONCURRENCY
# when unset. Leave blank to inherit.
IPFS_PRIVATE_ADD_TIMEOUT=
IPFS_PRIVATE_PIN_CONCURRENCY=
# Max size of a single original-file upload (Echo size string). Overrides
# HTTP_BODY_LIMIT for the upload route only; oversized uploads get 413.
UPLOAD_MAX_SIZE=2G
# Batch-upload guard (UPLOAD-10): the most ACTIVE (unfinished, unexpired)
# resumable upload sessions one user may hold at once. Opening one past the cap
# is 429 with the stable code too_many_active_uploads, which a batch-upload
# client queues on (cancelling or completing an in-flight session frees a slot).
# 0 disables the limit.
UPLOAD_MAX_ACTIVE_SESSIONS_PER_USER=5
# Default per-user storage quota in BYTES: the total stored size of a user's
# video files (originals, renditions, thumbnails) across the videos owned via
# their channels. 0 (or unset) = unlimited. Admins can override per account
# (PATCH /api/v1/admin/users/{id} storage_quota_bytes; null resets to this
# default, 0 = unlimited for that account). Uploads/imports that would exceed
# the effective quota are rejected with 422 quota_exceeded.
INSTANCE_DEFAULT_QUOTA_BYTES=0

# JWT access tokens (HS256). In production JWT_SECRET MUST be overridden with a
# strong value (>= 32 bytes); the dev default below is rejected when VIDRA_ENV=production.
JWT_SECRET=dev-insecure-jwt-secret-change-me-0000000000000000
JWT_ISSUER=vidra
JWT_AUDIENCE=vidra
JWT_ACCESS_TTL=15m
# Refresh-token (opaque, rotating) session lifetime.
JWT_REFRESH_TTL=720h

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=vidra
POSTGRES_PASSWORD=vidra
POSTGRES_DB=vidra
POSTGRES_PORT=5432

# Redis (matches docker-compose defaults)
REDIS_PORT=6379

# DATABASE_URL / REDIS_URL: LEAVE THESE COMMENTED OUT FOR LOCAL DEVELOPMENT.
#
# They are overrides for a deployment whose database/cache is NOT the compose
# postgres/redis (e.g. a managed Postgres on its own host with ?sslmode=require).
# docker-compose.yml reads them as ${DATABASE_URL:-<compose-network DSN>} /
# ${REDIS_URL:-<compose-network DSN>}, so setting them REPLACES the whole DSN.
#
# WHY COMMENTED: docker compose AUTO-LOADS this file's copy (.env) for variable
# interpolation, including when the meta-repo's docker-compose.yml `include:`s
# vidra-core's. A host-oriented "localhost" DSN set here therefore lands INSIDE
# the api container, where localhost is the container itself — postgres and redis
# become unreachable and the api fails to boot. The values below are exactly what
# config.Load() already defaults to when the variables are unset, so a host-side
# `make run` against a locally published postgres/redis needs no entry here at
# all. Uncomment ONLY when you genuinely mean to point the api elsewhere, and
# then use a host that resolves in the context the api runs in.
#
# Both are SECRETS once they carry real credentials — never commit a live value.
# Keep redis on DB index /0: vidra-search uses /1 on the same server.
# DATABASE_URL=postgres://vidra:vidra@localhost:5432/vidra?sslmode=disable
# REDIS_URL=redis://localhost:6379/0

# CORS: explicit, comma-separated allow-list. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── PeerTube import / migration (fix_plan P18, .ralph/specs/peertube-import.md) ──
# A one-way tool that reads an EXISTING PeerTube instance (its PostgreSQL DB +
# media storage) and maps it into Vidra. Read-only on the source; idempotent,
# resumable, dry-runnable, admin-only, audited. Everything is OFF BY DEFAULT.
#
# The cmd/peertube-import CLI takes its own --source-dsn / --source-storage flags
# and does NOT need these. These configure the ADMIN API path (POST/GET
# /api/v1/admin/peertube-import) + its worker, where the source connection comes
# from server config ONLY — never from the browser.
#
# Enable the admin import API + worker. Requires PEERTUBE_SOURCE_DATABASE_URL.
PEERTUBE_IMPORT_ENABLED=false
# READ-ONLY DSN of the source PeerTube PostgreSQL (a dump restored to a scratch
# DB, or a read-only replica). Connect with a least-privilege read-only role.
# SECRET — never commit or log a real value.
PEERTUBE_SOURCE_DATABASE_URL=
# Where the source instance's media lives: local (a read-only mounted copy) | s3.
PEERTUBE_SOURCE_STORAGE_BACKEND=local
# Directory the source media tree is mounted at (read-only), for the local backend.
PEERTUBE_SOURCE_STORAGE_LOCAL_ROOT=
# Source S3-compatible media store (read-only). Endpoint is host[:port], NO scheme.
# The access/secret keys are SECRETS — never commit or log them.
PEERTUBE_SOURCE_S3_ENDPOINT=
PEERTUBE_SOURCE_S3_BUCKET=
PEERTUBE_SOURCE_S3_ACCESS_KEY=
PEERTUBE_SOURCE_S3_SECRET_KEY=
PEERTUBE_SOURCE_S3_REGION=
PEERTUBE_SOURCE_S3_USE_SSL=true
PEERTUBE_SOURCE_S3_FORCE_PATH_STYLE=false
# Default resolution for username/handle/email/slug collisions between the source
# and this instance: skip (default, safest) | rename | merge | fail.
PEERTUBE_IMPORT_CONFLICT_POLICY=skip
# What to do with the source instance's media bytes: copy (default — read each
# object from the source store and write it into THIS instance's STORAGE_* backend)
# | reference (record the source location without copying; only valid when STORAGE_*
# already points at the same bucket as the source) | none (metadata only, no media).
# Validated even when import is disabled.
PEERTUBE_IMPORT_MEDIA_MODE=copy
