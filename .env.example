# Vidra core — example environment. Copy to .env and adjust for local dev.
# NEVER commit a real .env or any real secrets.

# Runtime environment: development | test | production
VIDRA_ENV=development

# Logging (see .ralph/specs/observability.md).
# Minimum emitted level: debug | info | warn | error (default info).
LOG_LEVEL=info
# Output format: json (default, production) | text (readable local dev).
LOG_FORMAT=json
# OpenTelemetry tracing (opt-in; zero cost when off). When OTEL_ENABLED=true,
# spans export to OTEL_EXPORTER_OTLP_ENDPOINT (host:port, no scheme) over
# OTEL_EXPORTER_OTLP_PROTOCOL (grpc | http/protobuf); the endpoint is required
# when enabled. vidra-core accepts inbound W3C traceparent so frontend↔backend
# traces correlate, and logs carry trace_id/span_id when a span is active.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=vidra-core

# Human-facing instance name (shown in NodeInfo / discovery).
INSTANCE_NAME=Vidra (dev)
# Malware scanning of uploaded originals before publish (fail-closed: infected or
# unscannable media is not published). Off by default; when on, CLAMAV_ADDR must
# point at a clamd daemon (host:port).
MALWARE_SCAN_ENABLED=false
CLAMAV_ADDR=
# HLS transcoding: when true, publishing a video enqueues a durable transcode job
# and an in-process worker produces an H.264/AAC HLS ladder (rungs 1080/720/480/360,
# capped at the source height) served at /api/v1/videos/{id}/hls/*. Requires ffmpeg
# and ffprobe on PATH (the Docker image ships them). Off by default.
TRANSCODING_ENABLED=false
# ActivityPub federation (see .ralph/specs/federation.md). Off by default: when
# FEDERATION_ENABLED=false all federation routes (NodeInfo, and later actors/
# WebFinger/inbox) are unmounted. When true, PUBLIC_BASE_URL must be set to this
# instance's canonical origin (no path/trailing slash; https in production) — it
# is used to build actor/object ids and the NodeInfo document URL.
FEDERATION_ENABLED=false
PUBLIC_BASE_URL=
# Base64 (standard) 32-byte key that envelope-encrypts federation actor private
# keys at rest (AES-256-GCM). REQUIRED in production when FEDERATION_ENABLED=true;
# empty in dev stores keys raw (with a boot warning). Generate with:
#   openssl rand -base64 32
# NEVER commit a real value.
FEDERATION_KEY_KEK=
# Whether public account signup is accepted (surfaced at GET /api/v1/instance).
REGISTRATION_ENABLED=true
# When true (and registration is enabled), signup files a pending request for
# admin approval instead of creating an account directly. Default false.
REGISTRATION_REQUIRE_APPROVAL=false
# DEV-ONLY test seam. When true, account-security tokens (password reset, email
# verification) are held in memory and retrievable via GET /api/v1/dev/email-token
# instead of being mailed, so end-to-end tests can complete the token flows. The
# route exists only when this is on and the process warns loudly on boot.
# NEVER enable in production — it exposes single-use credentials.
DEV_MAIL_CAPTURE_ENABLED=false
# DEV/TEST-ONLY: relax the URL-import SSRF guard so it may fetch private/loopback
# addresses (backed e2e imports from a loopback/compose-network origin, since a
# public origin isn't reachable in CI). NEVER enable in production — it re-opens
# the SSRF hole. The process warns loudly on boot when on.
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false
# Base RTMP ingest URL returned to a streamer on live-stream create (they append
# their stream key in OBS). Empty until an RTMP ingest is provisioned.
LIVE_RTMP_URL=
# Shared secret the media server (RTMP ingest) presents on the internal
# /api/v1/live/ingest/{start,stop} hooks (header X-Ingest-Secret) so only it can
# flip a stream's live state. Empty DISABLES the hooks (they 404). Set to a strong
# random value alongside your RTMP ingest.
LIVE_INGEST_SECRET=
# Optional instance about/legal metadata (surfaced at GET /api/v1/instance).
INSTANCE_DESCRIPTION=
INSTANCE_TERMS_URL=
INSTANCE_PRIVACY_URL=
INSTANCE_CONTACT_EMAIL=

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Per-request context deadline (handlers/DB observe it; WriteTimeout is the hard cap).
HTTP_REQUEST_TIMEOUT=30s
# Max accepted request body size (Echo size string, e.g. 8M, 512K). Oversized -> 413.
HTTP_BODY_LIMIT=8M

# Rate limiting (Redis fixed-window, per client IP) on the /api surface.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
# Stricter per-IP budget (same window) for sensitive auth endpoints — login,
# register, and the password-reset / email-verify confirmations.
AUTH_RATE_LIMIT_REQUESTS=10

# Media storage. Backend is "local" for now (s3/ipfs land later); the local
# backend writes media under STORAGE_LOCAL_ROOT.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/media
# Max size of a single original-file upload (Echo size string). Overrides
# HTTP_BODY_LIMIT for the upload route only; oversized uploads get 413.
UPLOAD_MAX_SIZE=2G

# JWT access tokens (HS256). In production JWT_SECRET MUST be overridden with a
# strong value (>= 32 bytes); the dev default below is rejected when VIDRA_ENV=production.
JWT_SECRET=dev-insecure-jwt-secret-change-me-0000000000000000
JWT_ISSUER=vidra
JWT_AUDIENCE=vidra
JWT_ACCESS_TTL=15m
# Refresh-token (opaque, rotating) session lifetime.
JWT_REFRESH_TTL=720h

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=vidra
POSTGRES_PASSWORD=vidra
POSTGRES_DB=vidra
POSTGRES_PORT=5432
DATABASE_URL=postgres://vidra:vidra@localhost:5432/vidra?sslmode=disable

# Redis (matches docker-compose defaults)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS: explicit, comma-separated allow-list. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
